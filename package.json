{
  "name": "writing-diff",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Private, client-side diff for comparing drafts of an essay.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
